#设置透明度
background-opacity=0.95

#设置字体和字体大小
font-family = "Cascadia Mono NF"
font-family = "Sarasa Mono SC Regular"
font-size = 11

# 窗口设置
window-decoration = client
window-theme = ghostty

window-width = 103
window-height = 29

# 标题栏设置
gtk-titlebar-style = tabs
gtk-wide-tabs = false

# 终端外观设置
cursor-style=bar
shell-integration-features = ssh-env

# 自动复制选中文本
copy-on-select = false
app-notifications = no-clipboard-copy

########################
# Split
########################

# 向右创建窗格
keybind = alt+shift++=new_split:right

# 向下创建窗格
keybind = alt+shift+-=new_split:down

keybind = shift+alt+backspace=close_surface

########################
# Pane Navigation
########################

# 在窗格之间移动
keybind = alt+shift+left=goto_split:left
keybind = alt+shift+down=goto_split:down
keybind = alt+shift+up=goto_split:up
keybind = alt+shift+right=goto_split:right


########################
# Resize Pane
########################

# 调整窗格大小（每次10px）
keybind = alt+shift+j=resize_split:left,10
keybind = alt+shift+k=resize_split:down,10
keybind = alt+shift+i=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# 平均分配所有窗格
keybind = alt+shift+0=equalize_splits


########################
# Zoom
########################

# 最大化/恢复当前窗格
keybind = alt+enter=toggle_split_zoom


keybind = ctrl+enter=unbind
